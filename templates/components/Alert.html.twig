{# Usage: https://github.com/GrinWay/web-app-bundle/blob/main/docs/twig-component.md #}

{% set class = cva({
    base: this.base,
    variants: {
        type: {
            primary: 'alert-primary',
            secondary: 'alert-secondary',
            success: 'alert-success',
            danger: 'alert-danger',
            warning: 'alert-warning',
            info: 'alert-info',
            light: 'alert-light',
            dark: 'alert-dark',
        },
        alignment: {
            left: 'text-left',
            center: 'text-center',
            right: 'text-right',
        },
        size: {
            lg: 'fs-3',
            md: 'fs-6',
            sm: 'small',
            normal: '',
        },
        position: {
            top: 'position-absolute top-0 start-0 end-0',
            sticky: 'position-sticky top-0 start-0 end-0',
            absolute: 'position-absolute top-0 end-0 start-0',
            normal: '',
        },
    },
    compoundVariants: [
        {
            type: ['danger', 'warning'],
            class: '',
        },
        {
            size: ['sm'],
            class: 'p-2',
        },
    ],
}) %}

<div
        class="{{- class.apply({
            type: this.type,
            size: this.size,
            alignment: this.alignment,
            position: this.position,
        }, attributes.render('class')) -}}"

        {{ attributes.defaults({
            role: 'alert',
            'data-controller': 'grinway--transition',
            'data-grinway--transition-target': 'element',
            'data-grinway--transition-init-shown-value': this.initShown ? 1 : 0,
            'data-grinway--transition-style-value': this.style,
            'data-grinway--transition-disappear-in-ms-value': this.disappearInMs,
            'data-grinway--transition-will-leave-value': this.willLeave ? 1 : 0,
            'data-grinway--transition-remove-after-leave-value': this.removeAfterLeave ? 1 : 0,
            'data-grinway--transition-hidden-class-value': this.hiddenClass,
            ...this.dopAttributes,
        }) }}
>
    {%- block content -%}{%- endblock content -%}
</div>
