{# Usage: https://github.com/GrinWay/web-app-bundle/blob/main/docs/twig-component.md #}

{% set class = cva({
    base: this.base,
    variants: {
        'this.type': {
            primary: 'alert-primary',
            secondary: 'alert-secondary',
            success: 'alert-success',
            danger: 'alert-danger',
            warning: 'alert-warning',
            info: 'alert-info',
            light: 'alert-light',
            dark: 'alert-dark',
        },
        'this.alignment': {
            left: 'text-left',
            center: 'text-center',
            right: 'text-right',
        },
        'this.size': {
            lg: 'font-size-lg',
            md: 'font-size-md',
            sm: 'small',
            normal: '',
        },
        'this.position': {
            top: 'position-absolute top-0 start-0 end-0',
            sticky: 'position-sticky top-0 start-0 end-0',
            absolute: 'position-absolute top-0 end-0 start-0',
            normal: '',
        },
    },
    compoundVariants: [
        {
            'this.type': ['danger', 'warning'],
            class: 'h5',
        },
        {
            'this.size': ['sm'],
            class: 'p-2',
        },
    ],
}) %}

<div
        class="{{- class.apply({
            'this.type': this.type,
            'this.size': this.size,
            'this.alignment': this.alignment,
            'this.position': this.position,
        }, attributes.render('class')) -}}"

        {{ attributes.defaults({
            role: 'alert',
            'data-controller': 'grinway-web-app--transition',
            'data-grinway-web-app--transition-target': 'element',
            'data-grinway-web-app--transition-init-shown-value': this.initShown ? 1 : 0,
            'data-grinway-web-app--transition-style-value': this.style,
            'data-grinway-web-app--transition-disappear-in-ms-value': this.disappearInMs,
            'data-grinway-web-app--transition-will-leave-value': this.willLeave ? 1 : 0,
            'data-grinway-web-app--transition-remove-after-leave-value': this.removeAfterLeave ? 1 : 0,
            'data-grinway-web-app--transition-hidden-class-value': this.hiddenClass,
        }) }}
>
    {%- block content -%}
        EMPTY ALERT
    {%- endblock content -%}
</div>
