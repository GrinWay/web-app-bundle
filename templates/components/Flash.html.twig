{# Usage: https://github.com/GrinWay/web-app-bundle/blob/main/docs/twig-component.md #}

{%- set class_cva = cva({
    'this.base': this.base,
    variants: {
        'this.position': {
            fixed: 'position-fixed top-0 end-0 start-0',
            sticky: 'position-sticky top-0 end-0 start-0',
            absolute: 'position-absolute top-0 end-0 start-0',
            normal: '',
        },
    },
}) -%}

<div
        class="{{ class_cva.apply({
            'this.position': this.position,
        }, attributes.render('class')) }}"

        {{ attributes.defaults({
            'data-controller': 'grinway-web-app--transition',
            'data-grinway-web-app--transition-init-shown-value': this.initShown ? 1 : 0,
            'data-grinway-web-app--transition-will-leave-value': this.willLeave ? 1 : 0,
            'data-grinway-web-app--transition-remove-after-leave-value': this.removeAfterLeave ? 1 : 0,
            'data-grinway-web-app--transition-style-value': this.style,
            'data-grinway-web-app--transition-disappear-in-ms-value': this.disappearInMs,
            'data-grinway-web-app--transition-hidden-class-value': this.hiddenClass,
        }) }}
>

    {%- block flash -%}

        <div
                data-turbo-temporary
                {{ stimulus_target('grinway-web-app--transition', 'element') }}
        >
            {% for flashObject in [
                {
                    type:     'success',
                    flashes:  this.flashes[constant('GrinWay\\Service\\Type\\NoteType::NOTICE')],
                },
                {
                    type:     'warning',
                    flashes:  this.flashes[constant('GrinWay\\Service\\Type\\NoteType::WARNING')],
                },
                {
                    type:     'danger',
                    flashes:  this.flashes[constant('GrinWay\\Service\\Type\\NoteType::ERROR')],
                },
                {
                    type:     'secondary',
                    flashes:  this.flashes['secondary'],
                },
                {
                    type:     'primary',
                    flashes:  this.flashes['rest'],
                },
            ] %}

                {%- for flash in flashObject.flashes -%}

                    <div>
                        {% if flash is iterable %}

                            {% set flashes = flash %}
                            {%- for flash in flashes -%}
                                {{ block('alert', '@GrinWayWebApp/flash/_block.html.twig') }}
                            {%- endfor -%}

                        {% else %}

                            {{ block('alert', '@GrinWayWebApp/flash/_block.html.twig') }}

                        {% endif %}
                    </div>

                {%- endfor -%}

            {% endfor %}
        </div>

    {%- endblock -%}
</div>
